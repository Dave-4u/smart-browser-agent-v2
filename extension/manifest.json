{
  "manifest_version": 3,
  "name": "Smart Labeling Assistant v2",
  "version": "3.2.0",
  "description": "One-click image A/B labeling helper. Floating button on the task page. Uses Gemini vision.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.azurewebsites.net/*",
    "https://secure-images-proxy.pulsar-eec.workers.dev/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.azurewebsites.net/*",
        "https://*.toloka.ai/*",
        "https://*.toloka.yandex.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Smart Labeling Assistant v2"
  }
}
